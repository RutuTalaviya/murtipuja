# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/murtipuja

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# OTP (MSG91) - https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_SENDER_ID=MRTPJA

# WhatsApp (MSG91) - Optional
MSG91_WHATSAPP_NUMBER=your_msg91_whatsapp_number
MSG91_WHATSAPP_TEMPLATE_NAME=your_msg91_whatsapp_template_name
MSG91_WHATSAPP_LANG=en

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id

# CORS
CORS_ORIGIN=http://localhost:3000

# Delhivery One Logistics - https://one.delhivery.com
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_PICKUP_LOCATION=Surat Studio
DELHIVERY_SANDBOX=false
DELHIVERY_RETURN_NAME=MurtiPuja Studio
DELHIVERY_RETURN_ADDRESS=C-504 Yamuna Palace, Satellite Rd, Sudama Chowk, Mota Varachha
DELHIVERY_RETURN_PINCODE=394101
DELHIVERY_RETURN_CITY=Surat
DELHIVERY_RETURN_STATE=Gujarat
DELHIVERY_RETURN_PHONE=+917990138678

